{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/schemas/rq2-bridge-library.schema.json",
  "title": "RQ2 Grounded Prerequisite Bridge Library Candidate",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "library_id", "topic_id", "status", "generated_by", "curriculum_model_binding", "pathway_bindings", "bridges"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "library_id": {"type": "string", "pattern": "^[A-Za-z0-9]+(?:[-_.][A-Za-z0-9]+)*$"},
    "topic_id": {"type": "string", "minLength": 1},
    "status": {"const": "candidate"},
    "generated_by": {"$ref": "#/$defs/generator"},
    "curriculum_model_binding": {"$ref": "#/$defs/modelBinding"},
    "pathway_bindings": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/pathwayBinding"}},
    "bridges": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/bridge"}}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "generator": {
      "type": "object", "additionalProperties": false,
      "required": ["agent", "agent_version", "skill", "skill_version", "generated_at"],
      "properties": {
        "agent": {"const": "grounded-bridge-library-builder"},
        "agent_version": {"const": "1.0"},
        "skill": {"const": "build-grounded-bridge-library"},
        "skill_version": {"const": "1.0"},
        "generated_at": {"type": "string", "format": "date-time"}
      }
    },
    "modelBinding": {
      "type": "object", "additionalProperties": false,
      "required": ["model_id", "file", "sha256"],
      "properties": {
        "model_id": {"type": "string", "minLength": 1},
        "file": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "pathwayBinding": {
      "type": "object", "additionalProperties": false,
      "required": ["pathway_id", "pathway_file", "pathway_sha256", "review_file", "review_sha256", "profile_id"],
      "properties": {
        "pathway_id": {"type": "string", "minLength": 1},
        "pathway_file": {"type": "string", "minLength": 1},
        "pathway_sha256": {"$ref": "#/$defs/sha256"},
        "review_file": {"type": "string", "minLength": 1},
        "review_sha256": {"$ref": "#/$defs/sha256"},
        "profile_id": {"type": "string", "minLength": 1}
      }
    },
    "learningOutcome": {
      "type": "object", "additionalProperties": false,
      "required": ["outcome_id", "text"],
      "properties": {
        "outcome_id": {"type": "string", "pattern": "^BO-[0-9]{2,}$"},
        "text": {"type": "string", "minLength": 1}
      }
    },
    "contentBlock": {
      "type": "object", "additionalProperties": false,
      "required": ["content_id", "kind", "text", "source_ids"],
      "properties": {
        "content_id": {"type": "string", "pattern": "^BC-[0-9]{2,}$"},
        "kind": {"type": "string", "enum": ["definition", "explanation", "procedure", "code_pattern", "worked_example", "safeguard"]},
        "text": {"type": "string", "minLength": 1},
        "source_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^SRC-[0-9]{2,}$"}}
      }
    },
    "source": {
      "type": "object", "additionalProperties": false,
      "required": ["source_id", "title", "provider", "url", "source_type", "accessed_at", "evidence_locator", "supports_content_ids"],
      "properties": {
        "source_id": {"type": "string", "pattern": "^SRC-[0-9]{2,}$"},
        "title": {"type": "string", "minLength": 1},
        "provider": {"type": "string", "minLength": 1},
        "url": {"type": "string", "format": "uri", "pattern": "^https://"},
        "source_type": {"type": "string", "enum": ["official_documentation", "institutional_course_material"]},
        "accessed_at": {"type": "string", "format": "date"},
        "evidence_locator": {"type": "string", "minLength": 1},
        "supports_content_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^BC-[0-9]{2,}$"}}
      }
    },
    "bridge": {
      "type": "object", "additionalProperties": false,
      "required": ["bridge_contract_id", "bridge_candidate_id", "concept_id", "name", "status", "requested_by_profile_ids", "supports_item_ids", "content_boundary", "learning_outcomes", "teaching_content", "excluded_content", "sources"],
      "properties": {
        "bridge_contract_id": {"type": "string", "pattern": "^BRC-[A-Z0-9-]+-v[0-9]+$"},
        "bridge_candidate_id": {"type": "string", "pattern": "^BR-[A-Z0-9-]+-v[0-9]+$"},
        "concept_id": {"type": "string", "minLength": 1},
        "name": {"type": "string", "minLength": 1},
        "status": {"const": "candidate"},
        "requested_by_profile_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "supports_item_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^RC-[0-9]{3,}$"}},
        "content_boundary": {"type": "string", "minLength": 1},
        "learning_outcomes": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/learningOutcome"}},
        "teaching_content": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/contentBlock"}},
        "excluded_content": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "sources": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/source"}}
      }
    }
  }
}
