  "released_bridges": [
    {
      "bridge_contract_id": "BRC-VECTOR-NORMS-NORMALIZATION-v1",
      "bridge_candidate_id": "BR-VECTOR-NORMS-NORMALIZATION-v1",
      "concept_id": "vector-norms-and-normalization",
      "name": "Euclidean vector norms and normalization",
      "status": "released",
      "requested_by_profile_ids": [
        "computer-science-year-2-rq2-pilot",
        "mechanical-engineering-year-2-rq2-pilot"
      ],
      "supports_item_ids": [
        "RC-005",
        "RC-010",
        "RC-016",
        "RC-017"
      ],
      "content_boundary": "Define the Euclidean norm, normalize a non-zero vector, and recognize zero-vector breakdown; exclude general normed-space theory.",
      "learning_outcomes": [
        {
          "outcome_id": "BO-01",
          "text": "Compute the Euclidean norm of a real vector."
        },
        {
          "outcome_id": "BO-02",
          "text": "Normalize a non-zero vector and verify that the result has unit Euclidean norm."
        },
        {
          "outcome_id": "BO-03",
          "text": "Recognize that the zero vector cannot be normalized by division by its norm."
        }
      ],
      "teaching_content": [
        {
          "content_id": "BC-01",
          "kind": "definition",
          "text": "For x = (x_1, ..., x_n)^T in R^n, the Euclidean norm is ||x||_2 = sqrt(x_1^2 + ... + x_n^2) = sqrt(x^T x).",
          "source_ids": [
            "SRC-01"
          ]
        },
        {
          "content_id": "BC-02",
          "kind": "procedure",
          "text": "For x != 0, compute r = ||x||_2 and set u = x/r. Then ||u||_2 = 1.",
          "source_ids": [
            "SRC-01"
          ]
        },
        {
          "content_id": "BC-03",
          "kind": "safeguard",
          "text": "If ||x||_2 = 0, then x is the zero vector and x/||x||_2 is undefined; stop before dividing.",
          "source_ids": [
            "SRC-01"
          ]
        },
        {
          "content_id": "BC-04",
          "kind": "worked_example",
          "text": "For x = (3, 4)^T, ||x||_2 = 5 and the normalized vector is (3/5, 4/5)^T.",
          "source_ids": [
            "SRC-01"
          ]
        }
      ],
      "excluded_content": [
        "General p-norm and normed-space theory",
        "Matrix norms",
        "Power-iteration update or convergence claims"
      ],
      "sources": [
        {
          "source_id": "SRC-01",
          "title": "Dot Products and Orthogonality",
          "provider": "University of California, Irvine / Mathematics LibreTexts",
          "url": "https://math.libretexts.org/Courses/University_of_California_Irvine/Linear_Algebra_%28Math_3A_UCI%29/03%3A_Vector_Geometry/3.04%3A_Dot_Products_and_Orthogonal_Complements/3.4.01%3A_Dot_Products_and_Orthogonality",
          "source_type": "institutional_course_material",
          "accessed_at": "2026-08-18",
          "evidence_locator": "Fact 1 (vector length), Definition: Unit Vector, Fact 3, and Example 3: gives ||x|| = sqrt(x dot x), states x dot x = 0 iff x = 0, restricts division by ||x|| to nonzero x, proves the normalized vector has length 1, and works x = (3,4)^T to (3/5,4/5)^T.",
          "supports_content_ids": [
            "BC-01",
            "BC-02",
            "BC-03",
            "BC-04"
          ]
        }
      ]
    },
