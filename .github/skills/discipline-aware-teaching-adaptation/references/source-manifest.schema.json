{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Authoritative Source Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["hash_algorithm", "sources"],
  "properties": {
    "hash_algorithm": {"const": "sha256"},
    "sources": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["source_id", "path", "format", "sha256", "size_bytes", "role"],
        "properties": {
          "source_id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
          "path": {"type": "string", "minLength": 1},
          "format": {"type": "string", "enum": ["markdown", "notebook", "pdf", "pptx", "code", "text", "other"]},
          "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "size_bytes": {"type": "integer", "minimum": 1},
          "role": {"type": "string", "enum": ["authoritative", "supplementary"]}
        }
      }
    }
  }
}
