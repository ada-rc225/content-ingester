{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Approved Frozen Contract Generation View",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "contract", "required_items", "conditional_items", "excluded_item_ids"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "contract": {
      "type": "object", "additionalProperties": false,
      "required": ["contract_id", "contract_version", "sha256", "topic"],
      "properties": {
        "contract_id": {"type": "string", "minLength": 1},
        "contract_version": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "topic": {"type": "string", "minLength": 1}
      }
    },
    "required_items": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/item"}},
    "conditional_items": {"type": "array", "items": {"$ref": "#/$defs/item"}},
    "excluded_item_ids": {
      "type": "array", "uniqueItems": true,
      "items": {"type": "string", "pattern": "^RC-[0-9]{3,}$"}
    }
  },
  "$defs": {
    "item": {
      "type": "object",
      "additionalProperties": false,
      "required": ["item_id", "item_type", "criticality", "content_basis", "canonical_statement", "canonical_latex", "formula_refs", "conditions", "prohibited_drift"],
      "properties": {
        "item_id": {"type": "string", "pattern": "^RC-[0-9]{3,}$"},
        "item_type": {"type": "string", "minLength": 1},
        "criticality": {"type": "string", "minLength": 1},
        "content_basis": {"type": "string", "enum": ["approved_as_written", "approved_correction"]},
        "canonical_statement": {"type": "string", "minLength": 1},
        "canonical_latex": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "formula_refs": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^FM-[0-9]{3,}$"}},
        "conditions": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "prohibited_drift": {"type": "array", "items": {"type": "string", "minLength": 1}}
      }
    }
  }
}
