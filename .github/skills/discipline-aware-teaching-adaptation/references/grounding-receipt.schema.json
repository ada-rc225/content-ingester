{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Frozen Grounding Receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "contract",
    "release",
    "validation",
    "source_materials",
    "grounding_inventory",
    "generation_view",
    "generation_items"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "contract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "contract_id", "contract_version", "topic", "lifecycle_status", "source_of_truth", "reviewer_id", "reviewer_role", "reviewed_at"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "contract_id": {"type": "string", "minLength": 1},
        "contract_version": {"type": "string", "minLength": 1},
        "topic": {"type": "string", "minLength": 1},
        "lifecycle_status": {"const": "frozen"},
        "source_of_truth": {"const": "curated_institutional_material"},
        "reviewer_id": {"type": "string", "minLength": 1},
        "reviewer_role": {"type": "string", "minLength": 1},
        "reviewed_at": {"type": "string", "format": "date-time"}
      }
    },
    "release": {
      "type": "object",
      "additionalProperties": false,
      "required": ["report_path", "report_sha256", "release_gate", "status", "released_at"],
      "properties": {
        "report_path": {"type": "string", "minLength": 1},
        "report_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "release_gate": {"type": "string", "minLength": 1},
        "status": {"const": "released"},
        "released_at": {"type": "string", "format": "date-time"}
      }
    },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["report_path", "report_sha256", "validator", "valid", "error_count"],
      "properties": {
        "report_path": {"type": "string", "minLength": 1},
        "report_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "validator": {"type": "string", "minLength": 1},
        "valid": {"const": true},
        "error_count": {"const": 0}
      }
    },
    "source_materials": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source_id", "path", "format", "sha256", "role"],
        "properties": {
          "source_id": {"type": "string", "minLength": 1},
          "path": {"type": "string", "minLength": 1},
          "format": {"type": "string", "minLength": 1},
          "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "role": {"type": "string", "minLength": 1}
        }
      }
    },
    "grounding_inventory": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      }
    },
    "generation_view": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"const": "grounding_view.json"},
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      }
    },
    "generation_items": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required_item_ids", "conditional_item_ids", "excluded_item_ids"],
      "properties": {
        "required_item_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^RC-[0-9]{3,}$"}
        },
        "conditional_item_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^RC-[0-9]{3,}$"}
        },
        "excluded_item_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^RC-[0-9]{3,}$"}
        }
      }
    }
  }
}
