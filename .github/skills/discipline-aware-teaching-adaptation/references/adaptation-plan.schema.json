{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Teaching Adaptation Plan",
  "type": "object",
  "required": [
    "topic",
    "profile_id",
    "source_files",
    "entry_point",
    "chapter_sequence",
    "discipline_bridges",
    "implementation_strategy",
    "assessment_strategy",
    "coverage_decisions"
  ],
  "properties": {
    "topic": {
      "type": "string",
      "minLength": 1
    },
    "profile_id": {
      "type": "string",
      "minLength": 1
    },
    "source_files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "entry_point": {
      "type": "object",
      "required": ["core_concept", "discipline_context", "rationale"],
      "properties": {
        "core_concept": {
          "type": "string"
        },
        "discipline_context": {
          "type": "string"
        },
        "rationale": {
          "type": "string"
        }
      }
    },
    "chapter_sequence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["order", "title", "purpose", "source_locators"],
        "properties": {
          "order": {
            "type": "integer",
            "minimum": 1
          },
          "title": {
            "type": "string"
          },
          "purpose": {
            "type": "string"
          },
          "source_locators": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "discipline_bridges": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["core_concept", "domain_mapping", "analogy_boundary"],
        "properties": {
          "core_concept": {
            "type": "string"
          },
          "domain_mapping": {
            "type": "string"
          },
          "analogy_boundary": {
            "type": "string"
          }
        }
      }
    },
    "implementation_strategy": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "assessment_strategy": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "coverage_decisions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["source_locator", "decision", "destination", "reason"],
        "properties": {
          "source_locator": {
            "type": "string"
          },
          "decision": {
            "type": "string",
            "enum": [
              "retained",
              "reordered",
              "summarised",
              "deferred",
              "omitted"
            ]
          },
          "destination": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          }
        }
      }
    }
  }
}
