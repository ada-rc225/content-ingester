{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Compact Teaching Adaptation Plan",
  "type": "object",
  "additionalProperties": false,
  "required": ["topic", "profile_id", "source_ids", "entry_point", "chapter_sequence", "implementation_strategy", "assessment_strategy"],
  "properties": {
    "topic": {"type": "string", "minLength": 1},
    "profile_id": {"type": "string", "minLength": 1},
    "source_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "entry_point": {
      "type": "object", "additionalProperties": false,
      "required": ["discipline_context", "rationale", "analogy_boundary"],
      "properties": {
        "discipline_context": {"type": "string", "minLength": 1, "maxLength": 500},
        "rationale": {"type": "string", "minLength": 1, "maxLength": 500},
        "analogy_boundary": {"type": "string", "minLength": 1, "maxLength": 500}
      }
    },
    "chapter_sequence": {
      "type": "array", "minItems": 3, "maxItems": 12,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["section_id", "order", "title", "purpose", "invariant_ids"],
        "properties": {
          "section_id": {"type": "string", "pattern": "^SEC-[0-9]{2}$"},
          "order": {"type": "integer", "minimum": 1},
          "title": {"type": "string", "minLength": 1, "maxLength": 120},
          "purpose": {"type": "string", "minLength": 1, "maxLength": 300},
          "invariant_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^INV-[A-Za-z0-9._-]+$"}}
        }
      }
    },
    "implementation_strategy": {"type": "string", "minLength": 1, "maxLength": 500},
    "assessment_strategy": {"type": "string", "minLength": 1, "maxLength": 500}
  }
}
