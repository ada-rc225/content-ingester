{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Core Mathematical and Algorithmic Invariants",
  "type": "object",
  "additionalProperties": false,
  "required": ["invariants"],
  "properties": {
    "invariants": {
      "type": "array",
      "minItems": 1,
      "maxItems": 12,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["invariant_id", "source_id", "locator", "type", "statement", "conditions"],
        "properties": {
          "invariant_id": {"type": "string", "pattern": "^INV-[A-Za-z0-9._-]+$"},
          "source_id": {"type": "string", "minLength": 1},
          "locator": {"type": "string", "minLength": 1, "maxLength": 160},
          "type": {
            "type": "string",
            "enum": ["definition", "equation", "assumption", "theorem", "convergence_result", "algorithm_rule", "code_semantics"]
          },
          "statement": {"type": "string", "minLength": 1, "maxLength": 600},
          "conditions": {
            "type": "array",
            "maxItems": 5,
            "items": {"type": "string", "maxLength": 200}
          }
        }
      }
    }
  }
}
