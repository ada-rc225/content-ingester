{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Compact Section-level Provenance",
  "type": "object",
  "additionalProperties": false,
  "required": ["profile_id", "source_ids", "sections", "source_issues"],
  "properties": {
    "profile_id": {"type": "string", "minLength": 1},
    "source_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "sections": {
      "type": "array", "minItems": 3, "maxItems": 12,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["section_id", "invariant_ids", "adaptation_types"],
        "properties": {
          "section_id": {"type": "string", "pattern": "^SEC-[0-9]{2}$"},
          "invariant_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^INV-[A-Za-z0-9._-]+$"}},
          "adaptation_types": {
            "type": "array", "minItems": 1, "uniqueItems": true,
            "items": {"type": "string", "enum": ["preserved", "reordered", "summarised", "discipline_bridge", "implementation_bridge", "pedagogical_scaffold"]}
          },
          "note": {"type": "string", "maxLength": 300}
        }
      }
    },
    "source_issues": {
      "type": "array", "maxItems": 10,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["source_id", "locator", "issue", "status"],
        "properties": {
          "source_id": {"type": "string", "minLength": 1},
          "locator": {"type": "string", "minLength": 1, "maxLength": 160},
          "issue": {"type": "string", "minLength": 1, "maxLength": 500},
          "status": {"type": "string", "enum": ["review_required", "interpretation_recorded", "not_blocking"]}
        }
      }
    }
  }
}
