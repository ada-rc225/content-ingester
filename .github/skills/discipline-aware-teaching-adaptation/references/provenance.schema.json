{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Frozen-contract Section Provenance",
  "type": "object",
  "additionalProperties": false,
  "required": ["profile_id", "source_ids", "grounding_contract", "sections", "exercises"],
  "properties": {
    "profile_id": {"type": "string", "minLength": 1},
    "source_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "grounding_contract": {
      "type": "object", "additionalProperties": false,
      "required": ["contract_id", "contract_version", "sha256"],
      "properties": {
        "contract_id": {"type": "string", "minLength": 1},
        "contract_version": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      }
    },
    "sections": {
      "type": "array", "minItems": 3, "maxItems": 12,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["section_id", "contract_item_ids", "adaptation_types"],
        "properties": {
          "section_id": {"type": "string", "pattern": "^SEC-[0-9]{2}$"},
          "contract_item_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^RC-[0-9]{3,}$"}},
          "adaptation_types": {
            "type": "array", "minItems": 1, "uniqueItems": true,
            "items": {"type": "string", "enum": ["preserved", "reordered", "summarised", "discipline_bridge", "implementation_bridge", "pedagogical_scaffold"]}
          },
          "note": {"type": "string", "maxLength": 300}
        }
      }
    },
    "exercises": {
      "type": "array",
      "maxItems": 10,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["exercise_id", "section_id", "contract_item_ids", "content_origin", "verification_method"],
        "properties": {
          "exercise_id": {"type": "string", "pattern": "^EX-[0-9]{3,}$"},
          "section_id": {"type": "string", "pattern": "^SEC-[0-9]{2}$"},
          "contract_item_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^RC-[0-9]{3,}$"}},
          "content_origin": {"const": "generated_pedagogical_material"},
          "verification_method": {"type": "string", "enum": ["contract_binding", "deterministic_calculation", "code_execution", "combined"]}
        }
      }
    }
  }
}
