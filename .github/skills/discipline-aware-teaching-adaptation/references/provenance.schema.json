{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Teaching Adaptation Provenance",
  "type": "object",
  "required": [
    "profile_id",
    "source_files",
    "records",
    "source_issues"
  ],
  "properties": {
    "profile_id": {
      "type": "string",
      "minLength": 1
    },
    "source_files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "records": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "record_id",
          "source_locator",
          "core_item",
          "transformation",
          "preservation_status",
          "destination"
        ],
        "properties": {
          "record_id": {
            "type": "string",
            "minLength": 1
          },
          "source_locator": {
            "type": "string",
            "minLength": 1
          },
          "core_item": {
            "type": "string",
            "minLength": 1
          },
          "transformation": {
            "type": "string",
            "enum": [
              "preserved",
              "reordered",
              "summarised",
              "discipline_bridge",
              "implementation_bridge",
              "deferred",
              "omitted"
            ]
          },
          "preservation_status": {
            "type": "string",
            "enum": [
              "exact",
              "notation_normalised",
              "meaning_preserved",
              "not_included"
            ]
          },
          "destination": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          }
        }
      }
    },
    "source_issues": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["source_locator", "issue", "impact", "status"],
        "properties": {
          "source_locator": {
            "type": "string"
          },
          "issue": {
            "type": "string"
          },
          "impact": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "review_required",
              "interpretation_recorded",
              "not_blocking"
            ]
          }
        }
      }
    }
  }
}
