{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RQ1 Frozen-grounding Run Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["research_question", "condition", "run_id", "topic", "profile_id", "provider", "model", "access_route", "prompt_version", "agent_version", "skill_version", "run_date", "source_ids", "grounding_receipt_file", "grounding_receipt_sha256", "code_execution_required", "word_count_protocol", "exercise_protocol"],
  "properties": {
    "research_question": {"const": "RQ1"},
    "condition": {"const": "c2-structured-grounding"},
    "run_id": {"type": "string", "minLength": 1},
    "topic": {"type": "string", "minLength": 1},
    "profile_id": {"type": "string", "minLength": 1},
    "provider": {"type": "string", "minLength": 1},
    "model": {"type": "string", "minLength": 1},
    "access_route": {"type": "string", "minLength": 1},
    "prompt_version": {"type": "string", "minLength": 1},
    "agent_version": {"const": "3.5"},
    "skill_version": {"const": "3.5"},
    "run_date": {"type": "string", "format": "date-time"},
    "source_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "grounding_receipt_file": {"const": "grounding_receipt.json"},
    "grounding_receipt_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "code_execution_required": {"type": "boolean"},
    "word_count_protocol": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "minimum", "maximum", "counting_method"],
      "properties": {
        "enabled": {"type": "boolean"},
        "minimum": {"type": "integer", "minimum": 0},
        "maximum": {"type": "integer", "minimum": 0},
        "counting_method": {"const": "english_prose_v1"}
      }
    },
    "exercise_protocol": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "expected_count", "required_types", "worked_solutions_required"],
      "properties": {
        "enabled": {"type": "boolean"},
        "expected_count": {"type": "integer", "minimum": 0, "maximum": 10},
        "required_types": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "enum": ["concept_check", "hand_calculation", "code_diagnostic", "derivation", "transfer", "other"]}
        },
        "worked_solutions_required": {"type": "boolean"}
      }
    },
    "generation_parameters": {"type": "object"},
    "notes": {"type": "array", "items": {"type": "string"}}
  }
}
