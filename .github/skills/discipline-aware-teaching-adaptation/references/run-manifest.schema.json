{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RQ1 Run Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["research_question", "condition", "run_id", "topic", "profile_id", "provider", "model", "access_route", "prompt_version", "agent_version", "skill_version", "run_date", "source_ids", "code_execution_required"],
  "properties": {
    "research_question": {"const": "RQ1"},
    "condition": {"const": "c2-structured-grounding"},
    "run_id": {"type": "string", "minLength": 1},
    "topic": {"type": "string", "minLength": 1},
    "profile_id": {"type": "string", "minLength": 1},
    "provider": {"type": "string", "minLength": 1},
    "model": {"type": "string", "minLength": 1},
    "access_route": {"type": "string", "minLength": 1},
    "prompt_version": {"type": "string", "minLength": 1},
    "agent_version": {"type": "string", "minLength": 1},
    "skill_version": {"type": "string", "minLength": 1},
    "run_date": {"type": "string", "format": "date-time"},
    "source_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "code_execution_required": {"type": "boolean"},
    "generation_parameters": {"type": "object"},
    "notes": {"type": "array", "items": {"type": "string"}}
  }
}
