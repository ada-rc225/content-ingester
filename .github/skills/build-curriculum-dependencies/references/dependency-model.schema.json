{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/schemas/curriculum-dependency-model-candidate.schema.json",
  "title": "Curriculum Dependency Model Candidate",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "model_id", "lifecycle_status", "source_contract",
    "builder", "items", "external_prerequisite_concepts", "review_status",
    "approval"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "model_id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*-dependencies-v[0-9]+$"},
    "lifecycle_status": {"const": "candidate"},
    "source_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contract_id", "contract_version", "topic", "file", "sha256"],
      "properties": {
        "contract_id": {"type": "string", "minLength": 1},
        "contract_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
        "topic": {"type": "string", "minLength": 1},
        "file": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      }
    },
    "builder": {
      "type": "object",
      "additionalProperties": false,
      "required": ["agent", "agent_version", "skill", "skill_version", "generated_at"],
      "properties": {
        "agent": {"const": "grounded-curriculum-dependency-builder"},
        "agent_version": {"type": "string", "enum": ["1.0", "1.1"]},
        "skill": {"const": "build-curriculum-dependencies"},
        "skill_version": {"type": "string", "enum": ["1.0", "1.1"]},
        "generated_at": {"type": "string", "format": "date-time"}
      }
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/dependencyItem"}
    },
    "external_prerequisite_concepts": {
      "type": "array",
      "items": {"$ref": "#/$defs/prerequisiteConcept"}
    },
    "review_status": {"const": "unreviewed"},
    "approval": {"type": "null"}
  },
  "$defs": {
    "itemIdArray": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^RC-[0-9]{3,}$"}
    },
    "conceptIdArray": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"}
    },
    "fallback": {
      "type": "object",
      "additionalProperties": false,
      "required": ["allowed", "instruction"],
      "properties": {
        "allowed": {"type": "boolean"},
        "instruction": {"type": ["string", "null"]}
      },
      "allOf": [
        {
          "if": {"properties": {"allowed": {"const": true}}},
          "then": {"properties": {"instruction": {"type": "string", "minLength": 1}}},
          "else": {"properties": {"instruction": {"type": "null"}}}
        }
      ]
    },
    "dependencyItem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "item_id", "hard_dependencies", "explanatory_dependencies",
        "implementation_dependencies", "co_requisite_item_ids",
        "recommended_neighbours", "external_prerequisite_concept_ids",
        "fallback_when_explanatory_dependencies_omitted", "rationale",
        "confidence", "review_status"
      ],
      "properties": {
        "item_id": {"type": "string", "pattern": "^RC-[0-9]{3,}$"},
        "hard_dependencies": {"$ref": "#/$defs/itemIdArray"},
        "explanatory_dependencies": {"$ref": "#/$defs/itemIdArray"},
        "implementation_dependencies": {"$ref": "#/$defs/itemIdArray"},
        "co_requisite_item_ids": {"$ref": "#/$defs/itemIdArray"},
        "recommended_neighbours": {"$ref": "#/$defs/itemIdArray"},
        "external_prerequisite_concept_ids": {"$ref": "#/$defs/conceptIdArray"},
        "fallback_when_explanatory_dependencies_omitted": {"$ref": "#/$defs/fallback"},
        "rationale": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        },
        "confidence": {"type": "string", "enum": ["low", "medium", "high"]},
        "review_status": {"const": "unreviewed"}
      }
    },
    "prerequisiteConcept": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "concept_id", "name", "need_type", "supports_item_ids",
        "bridge_candidate_id", "status", "content_boundary", "rationale"
      ],
      "properties": {
        "concept_id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
        "name": {"type": "string", "minLength": 1},
        "need_type": {"type": "string", "enum": ["required", "recommended"]},
        "supports_item_ids": {"$ref": "#/$defs/itemIdArray"},
        "bridge_candidate_id": {"type": "string", "pattern": "^BR-[A-Z0-9]+(?:-[A-Z0-9]+)*-v[0-9]+$"},
        "status": {"const": "candidate"},
        "content_boundary": {"type": "string", "minLength": 1},
        "rationale": {"type": "string", "minLength": 1}
      }
    }
  }
}
